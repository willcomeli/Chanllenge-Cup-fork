# Unified LLM configuration. Copy this file to .env and fill in LLM_API_KEY.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# Scanned PDFs require an OpenAI-compatible model that accepts image_url input.
# DeepSeek multimodal model used for scanned PDFs and image resumes.
LLM_VISION_MODEL=deepseek-v4-flash-vision-exp

# Enable resume LLM analysis in the online resume upload flow.
LLM_RESUME_ENABLED=true
# Enable LLM extraction for newly uploaded JD batches.
LLM_JD_ENABLED=true
